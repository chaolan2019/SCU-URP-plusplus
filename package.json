{
  "name": "scu-urp-plusplus",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "Modular source and reproducible userscript builds for SCU URP++.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "release:prepare": "node tools/prepare-release.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "check": "npm test && npm run build:check && node --check urppp.user.js && node --check urpppp.user.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "0.28.1",
    "jimp": "^1.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
